# Copy to .env (never commit .env). pm2/system env values override this file.
HD_ENV=development
# Dev: SQLite file (default var/hd_dev.sqlite3). Production: PostgreSQL.
# DATABASE_URL=postgresql+psycopg://hd:CHANGE_ME@127.0.0.1:5432/human_design
# Only needed if the browser calls the API from another origin (normally Next.js proxies /api).
# CORS_ORIGINS=https://admin.example.com
# COOKIE_SECURE=true
# Only when the admin runs inside a cross-site iframe (preview): none => Secure + Partitioned
# COOKIE_SAMESITE=lax
SESSION_HOURS=12
# Signs download/share links and encrypts stored LLM keys. Set a long random value in production.
# Empty => auto-generated var/secret_key. Changing it invalidates links and stored AI keys.
# HD_SECRET_KEY=
# Resume LLM reports interrupted by a restart (default true); total attempts per report
# HD_JOB_RECOVERY=true
# HD_JOB_MAX_ATTEMPTS=3
# Cached PDF/DOCX files (default var/artifacts)
# ARTIFACT_DIR=/home/ubuntu/human_design/var/artifacts  (ghi duong dan tuyet doi — .env khong hieu $HOME hay ~)
# Folder containing DejaVuSans*.ttf if not installed system-wide
# HD_FONT_DIR=
# LLM content mode (optional)
# HD_LLM_API_KEY=
# HD_LLM_MODEL=gpt-4o-mini
# Whitelist base_url LLM nội bộ (9router / Ollama / vLLM): host hoặc host:port, cách nhau dấu phẩy.
# Mặc định trống = chặn mọi URL http:// và IP nội bộ/localhost (chống SSRF).
# IP link-local 169.254.x (metadata đám mây) LUÔN bị chặn kể cả khi liệt kê ở đây.
# HD_LLM_ALLOWED_PRIVATE_HOSTS=192.168.1.50:3456
# User-Agent gửi khi gọi LLM: WAF (Cloudflare) chặn UA mặc định của urllib →
# HTTP 403 "error code: 1010". Mặc định Mozilla/5.0 (compatible; HumanDesign/1.0);
# nếu nhà cung cấp vẫn chặn thì set UA cụ thể họ yêu cầu ở đây.
# HD_LLM_USER_AGENT=
# GPT bridge (mcp/openapi_server.py): BẮT BUỘC khi HD_ENV=production — mọi request cần
# Authorization: Bearer <token>. Tự sinh: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# HD_GPT_TOKEN=
# CORS cho GPT bridge (mặc định tắt — ChatGPT Action gọi server-side không cần CORS)
# HD_GPT_CORS_ORIGINS=https://chatgpt.com
