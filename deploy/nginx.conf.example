# /etc/nginx/sites-available/human_design  — thay admin.example.com bằng tên miền thật.
# Sau đó: sudo ln -s /etc/nginx/sites-available/human_design /etc/nginx/sites-enabled/
#         sudo nginx -t && sudo systemctl reload nginx
#         sudo certbot --nginx -d admin.example.com     # certbot tự thêm HTTPS + chuyển hướng 80 → 443

# --- Chống brute-force đăng nhập (http context — nằm TRƯỚC block server) --------
# Key là TCP peer thật ($binary_remote_addr) — client không thể giả mạo như X-Forwarded-For.
limit_req_zone $binary_remote_addr zone=hd_login:10m rate=5r/m;
limit_req_status 429;

# Log KHÔNG giữ query string (?access_token=…, ?share=…) để token không rơi vào access log.
# Dùng $uri (chỉ path) thay vì $request_uri.
log_format hd_clean '$remote_addr - [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;

    client_max_body_size 5m;
    # Không để lộ phiên bản nginx
    server_tokens off;

    # Log sạch (không query string) cho toàn site.
    access_log /var/log/nginx/human_design.log hd_clean;

    # Đăng nhập: tối đa ~5 request/phút/IP + burst 5 (form bình thường không bị ảnh hưởng).
    location = /api/v1/auth/login {
        limit_req zone=hd_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;          # hd-web (Next.js); /api/* được Next chuyển sang hd-api
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Chat trợ lý stream từng token (SSE): tắt buffer để chữ hiện ngay từng chữ
    location = /api/v1/assistant/chat/stream {
        proxy_pass http://127.0.0.1:3000;          # hd-web (Next.js); /api/* được Next chuyển sang hd-api
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;          # hd-web (Next.js); /api/* được Next chuyển sang hd-api
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # "AI biên tập phần này" có thể chờ AI tới ~2 phút
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
